    max-height: 1.2em;
    overflow: hidden;
    text-overflow: ellipsis;
}
.dash-stat-label {
    font-size: 0.8rem;
    opacity: 0.75;
    margin-top: 0.15rem;
}
.dash-stat-sub {
    font-size: 0.7rem;
    opacity: 0.6;
    margin-top: 0.1rem;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ── 面板卡片统一高度 ── */
#onlinePanel,
#taskPanel {
    max-height: 260px;
    overflow: auto;
}
#onlinePanel::-webkit-scrollbar,
#taskPanel::-webkit-scrollbar {
    width: 4px;
}
#onlinePanel::-webkit-scrollbar-thumb,
#taskPanel::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 2px;
}

/* ── 表格行截断 ── */
#onlinePanel td {
    max-height: 2.5em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
#onlinePanel td strong {
    max-width: 180px;
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
}
#taskPanel td {
    max-width: 200px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ── 同步信息区高度 ── */
#syncPanel {
    max-height: 80px;
    overflow-y: auto;
}
</style>

