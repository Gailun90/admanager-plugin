<script>
// 全局搜索
(function(){
  var input = document.getElementById('globalSearchInput');
  var dropdown = document.getElementById('globalSearchDropdown');
  if(!input || !dropdown) return;
  var timer = null;

  input.addEventListener('input', function(){
    var q = input.value.trim();
    clearTimeout(timer);
    if(q.length < 2){
      dropdown.classList.remove('show');
      return;
    }
    timer = setTimeout(function(){
      dropdown.innerHTML = '<div class="adm-search-empty">搜索中...</div>';
      dropdown.classList.add('show');
      fetch('/plugins/admanager/ajax/global_search.php?q=' + encodeURIComponent(q))
        .then(function(r){return r.json();})
        .then(function(d){
          if(!d.success){dropdown.innerHTML='<div class="adm-search-empty">搜索失败</div>';return;}
          var data = d.data;
          var html = '';
          var total = (data.terminals||[]).length + (data.computers||[]).length + (data.users||[]).length + (data.groups||[]).length;
          if(total === 0){
            dropdown.innerHTML = '<div class="adm-search-empty">未找到相关结果</div>';
            return;
          }
          if(data.terminals && data.terminals.length){
            html += '<div class="adm-search-section">终端</div>';
            data.terminals.forEach(function(item){
              html += '<a class="adm-search-item" href="'+item.url+'">'+
                '<div class="adm-search-item-icon"><i class="ti ti-device-laptop"></i></div>'+
                '<div class="adm-search-item-text">'+
                '<div class="adm-search-item-title">'+item.name+'</div>'+
                '<div class="adm-search-item-meta">SN: '+item.serial+'</div>'+
                '</div></a>';
            });
          }
          if(data.computers && data.computers.length){
            html += '<div class="adm-search-section">GLPI 计算机</div>';
            data.computers.forEach(function(item){
              html += '<a class="adm-search-item" href="'+item.url+'">'+
                '<div class="adm-search-item-icon"><i class="ti ti-server"></i></div>'+
                '<div class="adm-search-item-text">'+
                '<div class="adm-search-item-title">'+item.name+'</div>'+
                '<div class="adm-search-item-meta">GLPI #'+item.id+'</div>'+
                '</div></a>';
            });
          }
          if(data.users && data.users.length){
            html += '<div class="adm-search-section">AD用户</div>';
            data.users.forEach(function(item){
              html += '<a class="adm-search-item" href="'+item.url+'">'+
                '<div class="adm-search-item-icon"><i class="ti ti-user"></i></div>'+
                '<div class="adm-search-item-text">'+
                '<div class="adm-search-item-title">'+item.name+' ('+item.sam+')</div>'+
                '<div class="adm-search-item-meta">'+(item.dept||item.mail||'')+'</div>'+
                '</div></a>';
            });
          }
          if(data.groups && data.groups.length){
            html += '<div class="adm-search-section">安全组</div>';
            data.groups.forEach(function(item){
              html += '<a class="adm-search-item" href="'+item.url+'">'+
                '<div class="adm-search-item-icon"><i class="ti ti-shield-lock"></i></div>'+
                '<div class="adm-search-item-text">'+
                '<div class="adm-search-item-title">'+item.name+'</div>'+
                '<div class="adm-search-item-meta">'+(item.desc||'')+'</div>'+
                '</div></a>';
            });
          }
          dropdown.innerHTML = html;
        })
        .catch(function(e){
          dropdown.innerHTML = '<div class="adm-search-empty">搜索出错: '+e.message+'</div>';
        });
    }, 300);
  });

  // 点击外部关闭下拉
  document.addEventListener('click', function(e){
    if(!e.target.closest('.adm-search-wrapper')){
      dropdown.classList.remove('show');
    }
  });
  input.addEventListener('focus', function(){
    if(input.value.trim().length >= 2) dropdown.classList.add('show');
  });
})();
</script>

