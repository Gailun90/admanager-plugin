    align-items: center;
    justify-content: center;
}
.dash-stat-card .card-body {
    padding: 0.5rem 1rem !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
}
.dash-stat-value {
    font-size: 1.75rem;
    line-height: 1.2;
