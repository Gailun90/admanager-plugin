<link rel="stylesheet" href="/plugins/admanager/css/adm.css">
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">

<div class="adm-page">
  <ul class="nav nav-tabs mb-3">
    <li class="nav-item">
      <a class="nav-link" href="/plugins/admanager/front/deploy_new_task.php">
        <i class="ti ti-send me-1"></i>新建任务
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="/plugins/admanager/front/deploy.php">
        <i class="ti ti-list-check me-1"></i>任务列表
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="/plugins/admanager/front/deploy_package.php">
        <i class="ti ti-package me-1"></i>软件仓库
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link active" href="/plugins/admanager/front/agent_triggers.php">
        <i class="ti ti-robot me-1"></i>AI 定时任务
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link" href="/plugins/admanager/front/deploy_config.php">
        <i class="ti ti-settings-cog me-1"></i>部署配置
      </a>
    </li>
  </ul>

  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center py-2">
      <h5 class="mb-0"><i class="ti ti-robot me-1"></i>AI 定时/上线触发任务（{{ triggers|length }}）</h5>
      <div class="d-flex gap-2">
        {% if can_write %}
        <button type="button" class="btn btn-sm btn-primary" onclick="openTriggerModal()">
          <i class="ti ti-plus me-1"></i>新建任务
        </button>
        {% endif %}
        <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
          <i class="ti ti-refresh me-1"></i>刷新
        </button>
      </div>
    </div>

    {% if load_error %}
      <div class="alert alert-danger m-3">加载失败：{{ load_error }}</div>
    {% elseif triggers is empty %}
      <div class="card-body text-muted text-center py-4">
        暂无 AI 安排的定时/上线触发任务<br>
        <small>点右上角"新建任务"手动创建，或在 AI 对话里让它"定时执行 XXX"/"某终端上线时执行 XXX"</small>
      </div>
    {% else %}
    <div class="table-responsive">
      <table class="table adm-table table-hover table-sm mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>任务名称</th>
            <th>触发方式</th>
            <th>命令 / 动作</th>
            <th>优先级</th>
            <th>目标终端</th>
            <th>创建时间</th>
            {% if can_write %}<th>操作</th>{% endif %}
          </tr>
        </thead>
        <tbody>
          {% for t in triggers %}
          <tr data-key="{{ t.key }}"
              data-name="{{ t.name }}"
              data-task-type="{{ t.task_type|default('run_command') }}"
              data-trigger-type="{{ t.trigger_type }}"
              data-command="{{ t.command|default('') }}"
              data-interpreter="{{ t.interpreter|default('powershell') }}"
              data-priority="{{ t.priority|default('normal') }}"
              data-scheduled-at="{{ t.scheduled_at|default('') }}"
              data-client-ids="{{ t.target_clients|map(c => c.id)|join(',') }}">
            <td class="fw-bold">{{ t.name }}</td>
            <td>
              {% if t.trigger_type == 'scheduled' %}
                <span class="badge bg-info text-dark"><i class="ti ti-clock"></i> 定时</span>
                {% if t.scheduled_at %}
                  <div class="small text-muted">{{ t.scheduled_at_fmt ?? '—' }}</div>
                {% endif %}
              {% else %}
                <span class="badge bg-primary"><i class="ti ti-plug-connected"></i> 终端上线时</span>
              {% endif %}
            </td>
            <td class="small" style="max-width:380px;white-space:pre-wrap;word-break:break-all">
              {% if t.command %}
                <code>{{ t.command|slice(0,200) }}{% if t.command|length > 200 %}…{% endif %}</code>
                <div class="text-muted">解释器: {{ t.interpreter|default('powershell') }}</div>
              {% else %}
                <span class="text-muted">{{ t.task_type|default('—') }}</span>
              {% endif %}
            </td>
            <td>
              {% if t.priority == 'high' or t.priority == 'urgent' %}
                <span class="badge bg-danger">{{ t.priority }}</span>
              {% elseif t.priority == 'low' %}
                <span class="badge bg-secondary">{{ t.priority }}</span>
              {% else %}
                <span class="badge bg-light text-dark">{{ t.priority|default('normal') }}</span>
              {% endif %}
            </td>
            <td>
              <span class="badge bg-warning text-dark">{{ t.remaining_count }} 台待命中</span>
              <div class="small text-muted" style="max-width:260px;white-space:normal">
                {% for c in t.target_clients|slice(0,6) %}
                  {{ c.hostname }}{% if not loop.last %}、{% endif %}
                {% endfor %}
                {% if t.target_clients|length > 6 %}…等{{ t.target_clients|length }}台{% endif %}
              </div>
            </td>
            <td class="small text-muted">
              {{ t.created_at_fmt }}
            </td>
            {% if can_write %}
            <td>
              <div class="btn-group btn-group-xs">
                <button type="button" class="btn btn-xs btn-outline-secondary edit-trigger-btn" title="编辑">
                  <i class="ti ti-pencil"></i>
                </button>
                <form method="post" class="d-inline" onsubmit="return confirm('确定取消「{{ t.name|e('js') }}」这个定时任务？')">
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                  <input type="hidden" name="_action" value="cancel_trigger">
                  <input type="hidden" name="trigger_key" value="{{ t.key }}">
                  <button type="submit" class="btn btn-xs btn-outline-danger" title="取消">
                    <i class="ti ti-x"></i>
                  </button>
                </form>
              </div>
            </td>
            {% endif %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </div>
</div>

{% if can_write %}
<div class="modal fade" id="triggerModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form method="post" id="triggerForm">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
        <input type="hidden" name="_action" value="save_trigger">
        <input type="hidden" name="edit_key" id="f_edit_key" value="">
        <input type="hidden" name="client_ids" id="f_client_ids_hidden" value="">
        <div class="modal-header py-2">
          <h5 class="modal-title" id="triggerModalTitle">新建 AI 定时任务</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-2">
            <label class="form-label small fw-bold">任务名称 *</label>
            <input type="text" name="name" id="f_name" class="form-control form-control-sm" required>
          </div>

          <div class="row">
            <div class="col-6 mb-2">
              <label class="form-label small fw-bold">触发方式</label>
              <select name="trigger_type" id="f_trigger_type" class="form-select form-select-sm">
                <option value="online">终端上线时</option>
                <option value="scheduled">定时（指定时间）</option>
              </select>
            </div>
            <div class="col-6 mb-2" id="scheduledAtWrap" style="display:none">
              <label class="form-label small fw-bold">执行时间</label>
              <input type="datetime-local" name="scheduled_at" id="f_scheduled_at" class="form-control form-control-sm">
            </div>
          </div>

          <div class="mb-2">
            <label class="form-label small fw-bold">目标终端 *</label>
            <select id="f_client_ids" class="form-select form-select-sm" multiple></select>
          </div>

          <div class="row">
            <div class="col-6 mb-2">
              <label class="form-label small fw-bold">任务类型</label>
              <select name="task_type" id="f_task_type" class="form-select form-select-sm">
                <option value="run_command">执行命令</option>
              </select>
            </div>
            <div class="col-6 mb-2">
              <label class="form-label small fw-bold">解释器</label>
              <select name="interpreter" id="f_interpreter" class="form-select form-select-sm">
                <option value="powershell" selected>PowerShell</option>
                <option value="cmd">CMD</option>
                <option value="bat">Bat</option>
              </select>
            </div>
          </div>

          <div class="mb-2">
            <label class="form-label small fw-bold">命令内容</label>
            <textarea name="command" id="f_command" class="form-control form-control-sm" rows="4"
              placeholder="例如：Remove-Item 'C:\Users\Public\Downloads\*.bat' -Force"></textarea>
          </div>

          <div class="mb-2">
            <label class="form-label small fw-bold">优先级</label>
            <select name="priority" id="f_priority" class="form-select form-select-sm" style="max-width:200px">
              <option value="low">低</option>
              <option value="normal" selected>普通</option>
              <option value="high">高</option>
              <option value="urgent">紧急</option>
            </select>
          </div>
        </div>
        <div class="modal-footer py-2">
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">取消</button>
          <button type="submit" class="btn btn-sm btn-primary">保存</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
(function(){
  var tsClients = null;

  function initTs() {
    if (!window.TomSelect || tsClients) return;
    tsClients = new TomSelect('#f_client_ids', {
      placeholder: '搜索主机名…', maxOptions: 500, plugins: ['remove_button'],
    });
  }

  function ensureTsLoaded(cb) {
    if (window.TomSelect) { initTs(); cb(); return; }
    var s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js';
    s.onload = function(){ initTs(); cb(); };
    document.head.appendChild(s);
  }

  function toggleScheduledAt() {
    var isScheduled = document.getElementById('f_trigger_type').value === 'scheduled';
    document.getElementById('scheduledAtWrap').style.display = isScheduled ? '' : 'none';
  }
  document.getElementById('f_trigger_type').addEventListener('change', toggleScheduledAt);

  window.openTriggerModal = function(rowData) {
    ensureTsLoaded(function() {
      var clientOptions = [
        {% for c in clients %}
        {value: "{{ c.id }}", text: "{{ c.hostname|default(c.name)|e('js') }}"},
        {% endfor %}
      ];
      tsClients.clearOptions();
      clientOptions.forEach(function(o){ tsClients.addOption(o); });
      tsClients.refreshOptions(false);
      tsClients.clear();

      if (rowData) {
        document.getElementById('triggerModalTitle').textContent = '编辑：' + rowData.name;
        document.getElementById('f_edit_key').value = rowData.key;
        document.getElementById('f_name').value = rowData.name;
        document.getElementById('f_trigger_type').value = rowData.triggerType;
        document.getElementById('f_command').value = rowData.command;
        document.getElementById('f_interpreter').value = rowData.interpreter;
        document.getElementById('f_priority').value = rowData.priority;
        if (rowData.scheduledAt) {
          document.getElementById('f_scheduled_at').value = rowData.scheduledAt.substring(0,16);
        }
        (rowData.clientIds || []).forEach(function(id){ tsClients.addItem(id, true); });
      } else {
        document.getElementById('triggerModalTitle').textContent = '新建 AI 定时任务';
        document.getElementById('triggerForm').reset();
        document.getElementById('f_edit_key').value = '';
      }
      toggleScheduledAt();
      new bootstrap.Modal(document.getElementById('triggerModal')).show();
    });
  };

  document.querySelectorAll('.edit-trigger-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var tr = btn.closest('tr');
      var clientIdsStr = tr.dataset.clientIds || '';
      window.openTriggerModal({
        key: tr.dataset.key,
        name: tr.dataset.name,
        triggerType: tr.dataset.triggerType,
        command: tr.dataset.command,
        interpreter: tr.dataset.interpreter,
        priority: tr.dataset.priority,
        scheduledAt: tr.dataset.scheduledAt,
        clientIds: clientIdsStr ? clientIdsStr.split(',') : [],
      });
    });
  });

  document.getElementById('triggerForm').addEventListener('submit', function() {
    if (tsClients) {
      document.getElementById('f_client_ids_hidden').value = tsClients.getValue().join(',');
    }
  });
})();
</script>
{% endif %}
